{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "elarin",
  "version": "0.1.0",
  "identifier": "com.elarin.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "elarin",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/elarin_icon.ico"]
  }
}
